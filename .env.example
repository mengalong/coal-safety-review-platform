COAL_APP_NAME=煤矿安标技术文档智能审核平台
COAL_ENVIRONMENT=development
COAL_STORE_BACKEND=database
COAL_SEED_DEMO_DATA=true
COAL_API_V1_PREFIX=/api/v1
COAL_DATABASE_URL=sqlite+pysqlite:///./coal.db
COAL_REDIS_URL=redis://localhost:6379/0
COAL_MINIO_ENDPOINT=localhost:9000
COAL_MINIO_ACCESS_KEY=coal
COAL_MINIO_SECRET_KEY=coal-local-secret
COAL_MINIO_BUCKET=coal-review
COAL_MINIO_SECURE=false
COAL_STORAGE_BACKEND=local
COAL_LOCAL_STORAGE_PATH=./data/uploads
COAL_OCR_BACKEND=disabled
COAL_OCR_LANGUAGES=chi_sim+eng
COAL_OCR_DPI=200
COAL_OCR_TIMEOUT_SECONDS=120
COAL_OCR_MINIMUM_CONFIDENCE=0.35
COAL_SECRET_KEY=development-only-change-this-secret-key
COAL_MODEL_SECRET_KEY=development-only-change-this-model-secret-key
COAL_QIANFAN_API_KEY=
COAL_QIANFAN_BASE_URL=https://qianfan.baidubce.com/v2
COAL_MODEL_MAX_RETRIES=2
COAL_MODEL_MAX_RESPONSE_BYTES=5242880
COAL_MODEL_CIRCUIT_FAILURE_THRESHOLD=3
COAL_MODEL_CIRCUIT_RECOVERY_SECONDS=30
COAL_ACCESS_TOKEN_EXPIRE_MINUTES=480
COAL_JWT_ALGORITHM=HS256
COAL_LOG_LEVEL=INFO
COAL_CORS_ORIGINS=["http://127.0.0.1:65513","http://localhost:65513"]
