COAL_PUBLIC_HTTPS_PORT=8443
COAL_PUBLIC_ORIGIN=https://coal-review.example.com:8443
COAL_API_IMAGE=registry.example.com/coal-safety-review-api@sha256:replace-with-image-digest
COAL_WEB_IMAGE=registry.example.com/coal-safety-review-web@sha256:replace-with-image-digest
COAL_TLS_CERT_FILE=./deploy/tls/tls.crt
COAL_TLS_KEY_FILE=./deploy/tls/tls.key
COAL_POSTGRES_PASSWORD=replace-with-random-database-password
COAL_REDIS_PASSWORD=replace-with-random-redis-password
COAL_MINIO_ACCESS_KEY=replace-with-random-minio-access-key
COAL_MINIO_SECRET_KEY=replace-with-random-minio-secret-key
COAL_SECRET_KEY=replace-with-at-least-32-random-characters
COAL_METRICS_TOKEN=replace-with-at-least-32-random-characters
COAL_METRICS_TOKEN_FILE=./deploy/secrets/metrics-token
COAL_MODEL_SECRET_KEY=replace-with-at-least-32-random-characters
COAL_QIANFAN_API_KEY=inject-from-secret-manager
COAL_GRAFANA_BIND=127.0.0.1
COAL_GRAFANA_ADMIN_PASSWORD=replace-with-random-grafana-password
COAL_ALERT_WEBHOOK_URL=https://operations.example.com/coal-alerts
COAL_ALERT_WEBHOOK_TOKEN=inject-from-secret-manager
# COAL_BACKUP_AGE_RECIPIENT=age1replace-with-backup-recipient
# COAL_BACKUP_AGE_IDENTITY_FILE=/secure/age/coal-backup-identity.txt
